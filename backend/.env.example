# Backend Environment Variables
PORT=5000
MONGODB_URI=mongodb://localhost:27017/weekly-report
# For Atlas use:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/weekly-report
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=development

# AI integration (weekly summary + text polishing)
# 1. Paste your AI tool's API key here (in your real .env, NOT here)
# 2. Leave BASE_URL + MODEL as-is for OpenAI
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# For Gemini instead, use:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-2.0-flash
